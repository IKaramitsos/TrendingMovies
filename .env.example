# Server-side only (read by the /api functions, never sent to the browser)
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Public client-side identifiers (VITE_ prefix = bundled into the browser build)
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id_here
VITE_APPWRITE_DATABASE_ID=your_appwrite_database_id_here
VITE_APPWRITE_TABLE_ID=your_appwrite_table_id_here

